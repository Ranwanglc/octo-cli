{
  "openapi": "3.1.0",
  "info": {
    "title": "Octo Docs HTML API",
    "version": "1.0.0",
    "description": "Read/write endpoints for the octo-docs-html backend under /v1/docs. Separate product surface from the Octo Bot API — routes to OCTO_DOC_API_URL with its own OCTO_DOC_WRITE_TOKEN, bypassing the bot-credential chain."
  },
  "x-octo-service": "html",
  "x-octo-base-url": "OCTO_DOC_API_URL",
  "x-octo-token-env": "OCTO_DOC_WRITE_TOKEN",
  "x-octo-space-header": false,
  "paths": {
    "/v1/docs": {
      "get": {
        "operationId": "html.list",
        "summary": "List documents on the octo-docs-html backend",
        "x-octo-risk": "read",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "1-based page number"
          },
          {
            "name": "page_size",
            "in": "query",
            "schema": { "type": "integer", "default": 20 },
            "description": "items per page (1..100, backend clamps)"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of documents",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "slug": { "type": "string" },
                          "title": { "type": "string" },
                          "latest": { "type": "string" },
                          "updated": { "type": "string" }
                        }
                      }
                    },
                    "pagination": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer" },
                        "page": { "type": "integer" },
                        "page_size": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
